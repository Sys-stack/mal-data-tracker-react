# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets. For the GitHub Action,
# set these same values as repo Secrets (MAL_CLIENT_ID, DB_*, SUPABASE_*)
# and repo Variables (TRACK_SEASON, TRACK_YEAR, TRACK_IDS) instead.

MAL_CLIENT_ID=your_mal_client_id_here

# Comma-separated MyAnimeList anime IDs to track (from the show's MAL URL)
TRACK_IDS=58929,61126,61169,61483,62856,62983,63403,63832
TRACK_SEASON=fall
TRACK_YEAR=2026

# Postgres connection (Supabase project settings -> Database -> Connection info).
# DATABASE_URL is preferred by Render/Railway/Fly/etc.; use it instead of the
# individual DB_* entries when your host supplies one.
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
DB_HOST=aws-1-xx-xxxxx.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_db_password
DB_NAME=postgres
DB_SSLMODE=require

# Only needed if you use the Supabase client/REST API directly; the app
# itself talks to Postgres via psycopg2 and doesn't require these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_key

# SQLite is the fast request-time cache. Its complete application state is
# automatically backed up to Supabase after writes and restored on a fresh
# web-service instance or GitHub Action runner. Safe to .gitignore.
LOCAL_DB_PATH=fal_local.db

# The "cap" on predicted Watching+Completed members for Ace eligibility.
# Matches the current live FAL season's threshold; check fal.myanimelist.net
# each season since MAL adjusts this number.
ACE_THRESHOLD=60000
